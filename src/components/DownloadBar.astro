---
const { slug } = Astro.props;

const allFiles = import.meta.glob('/src/content/writeups/**/*.*', { 
  query: '?url', 
  import: 'default',
  eager: true 
});
const downloadableFiles = Object.entries(allFiles)
  .filter(([filePath]) => {
    if (filePath.endsWith('.md') || filePath.endsWith('.mdx')) return false;
    
    const normalizedFilePath = filePath.toLowerCase();
    const targetPath = `/src/content/writeups/${slug}/`.toLowerCase();
    
    return normalizedFilePath.includes(targetPath);
  })
  .map(([filePath, url]) => {
    const fileName = filePath.split('/').pop();
    return { fileName, url: url as string };
  });
const fileUrls = JSON.stringify(downloadableFiles.map(f => f.url));
---

{downloadableFiles.length > 0 && (
  <details class="asset-dashboard" open>
    <summary class="asset-header">
      <div class="asset-title-group">
        <span class="chevron">▼</span>
        <h3 class="asset-title">Artifacts</h3>
        <span class="asset-count">({downloadableFiles.length})</span>
      </div>
      
      {downloadableFiles.length > 1 && (
        <button class="download-all-btn" data-urls={fileUrls} type="button">
          ↓ Download All
        </button>
      )}
    </summary>

    <div class="asset-list-container">
      <ul class="asset-grid">
        {downloadableFiles.map((file) => (
          <li>
            <a href={file.url} download class="asset-item" title={file.fileName}>
              <span class="icon">↓</span>
              <span class="filename">{file.fileName}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
)}

<style>
  .asset-dashboard {
    border: 1px solid var(--border);
    border-radius: 6px;
    margin: 1.5rem 0 2rem 0;
    overflow: hidden;
    background: #141414;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .asset-dashboard:hover {
    border-color: #333333;
  }

  .asset-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: #ffffff06;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background-color 0.15s ease;
  }

  .asset-header::-webkit-details-marker {
    display: none;
  }

  .asset-header:hover {
    background: #ffffff0d;
  }

  .asset-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chevron {
    font-size: 10px;
    color: var(--dim);
    transition: transform 0.2s ease;
    display: inline-block;
  }

  details:not([open]) .chevron {
    transform: rotate(-90deg);
  }

  details[open] .chevron {
    transform: rotate(0deg);
  }

  .asset-title {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
  }

  .asset-count {
    font-size: 12px;
    color: var(--dim);
  }

  .download-all-btn {
    background-color: #ffffff10;
    color: var(--fg); 
    border: 1px solid var(--border);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .download-all-btn:hover {
    background-color: var(--link);
    color: #111111;
    border-color: var(--link);
  }

  .asset-list-container {
    max-height: 250px; 
    overflow-y: auto;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
  }

  .asset-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .asset-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem; 
    background-color: #ffffff06; 
    border: 1px solid var(--border);
    border-radius: 4px; 
    text-decoration: none;
    color: var(--fg);
    transition: all 0.15s ease;
  }

  .asset-item:hover {
    background-color: #ffffff0f;
    border-color: var(--link);
    color: var(--link);
    text-decoration: none;
  }

  .icon {
    color: var(--link);
    font-size: 12px;
  }

  .filename {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 12px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.download-all-btn');
    
    buttons.forEach(button => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        event.preventDefault();
        const target = event.currentTarget as HTMLButtonElement;
        const urls = JSON.parse(target.dataset.urls || '[]');
        
        const originalText = target.innerText;
        target.innerText = "Downloading...";
        target.disabled = true;

        urls.forEach((url: string, index: number) => {
          setTimeout(() => {
            const a = document.createElement('a');
            a.href = url;
            a.download = '';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            
            if (index === urls.length - 1) {
              setTimeout(() => {
                target.innerText = originalText;
                target.disabled = false;
              }, 500);
            }
          }, index * 300); 
        });
      });
    });
  });
</script>