---
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const pathname = Astro.url.pathname;

const navItems = [
  { name: 'home', href: base, active: pathname === base || pathname === base.slice(0, -1) },
  { name: 'events', href: `${base}events/`, active: pathname.includes('/events') },
  { name: 'writeups', href: `${base}writeups/`, active: pathname.includes('/writeups') },
  { name: 'projects', href: `${base}projects/`, active: pathname.includes('/projects') },
  { name: 'about', href: `${base}about/`, active: pathname.includes('/about') },
];
---

<header>
  <div class="site-name">
    <a href={base} style="color: inherit; text-decoration: none;">NUTFLAGGERS</a><span class="cursor"></span>
  </div>
  <div class="site-tagline">we capture flags. sometimes.</div>

  <nav aria-label="Primary navigation">
    {navItems.map((item) => (
      <a href={item.href} class={item.active ? 'active' : ''}>
        {item.name}
      </a>
    ))}
  </nav>
</header>

