---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMember from '../components/TeamMember.astro';
import { getCollection } from 'astro:content';

const allMembers = await getCollection('team');

// Gather unique categories from all team members
const categorySet = new Set<string>();
allMembers.forEach((member) => {
  (member.data.categories || []).forEach((cat) => categorySet.add(cat));
});

const allCategories = Array.from(categorySet).sort((a, b) => {
  if (a.toLowerCase() === 'exco') return -1;
  if (b.toLowerCase() === 'exco') return 1;
  return a.localeCompare(b);
});
---

<BaseLayout title="About Us — NUTFLAGGERS" description="About NUTFLAGGERS student CTF team, member roster, and contact info.">
  <section id="about">
    <div class="section-title">── about us</div>
    <p class="about-text">
      We are NUTFLAGGERS — a student CTF team. We compete, write things up, build tools, and try to learn something every time. If you're interested in security, come find us.
    </p>

    {allCategories.map((cat) => {
      const catMembers = allMembers.filter((m) =>
        (m.data.categories || []).includes(cat)
      );

      return (
        <div style="margin-top: 32px;">
          <div class="section-title">── {cat}</div>
          <div class="team-list">
            {catMembers.map((member) => (
              <TeamMember
                handle={member.data.handle}
                role={member.data.role}
                skills={member.data.skills}
                socials={member.data.socials}
              />
            ))}
          </div>
        </div>
      );
    })}

    <div class="section-title" style="margin-top: 36px;">── find us</div>
    <div class="socials">
      <a href="https://discord.gg" target="_blank" rel="noopener noreferrer">discord</a>
      <a href="https://github.com/NUTFLAGGERS" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://ctftime.org" target="_blank" rel="noopener noreferrer">ctftime</a>
      <a href="https://twitter.com" target="_blank" rel="noopener noreferrer">twitter</a>
      <a href="mailto:contact@nutflaggers.org">email</a>
    </div>
  </section>
</BaseLayout>
