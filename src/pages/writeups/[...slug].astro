---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import DownloadBar from '../../components/DownloadBar.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<BaseLayout 
  title={`${entry.data.title} — NUTFLAGGERS Writeups`} 
  description={entry.data.description || `Writeup for ${entry.data.title}`}
>
  <article>
    <div class="writeup-header">
      <a href={`${base}writeups/`} class="back-link">← back to writeups</a>
      <h1>{entry.data.title}</h1>
      <div class="writeup-meta">
        <span>Published {entry.data.pubDate}</span>
        {(entry.data.updatedDate || entry.data.lastUpdated) && (
          <span> (Updated {entry.data.updatedDate || entry.data.lastUpdated})</span>
        )}
        {entry.data.event && <span> · Event: {entry.data.event}</span>}
        {entry.data.author && <span> · Author: {entry.data.author}</span>}
        {entry.data.score && <span> · {entry.data.score}</span>}
      </div>
      {entry.data.tags && entry.data.tags.length > 0 && (
        <div class="tags" style="margin-top: 8px;">
          {entry.data.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
      <DownloadBar slug={entry.slug} />
    </div>

    <div class="writeup-content">
      <Content />
    </div>
  </article>

  <!-- Image Lightbox Modal -->
  <div id="image-lightbox" class="lightbox-modal" aria-hidden="true">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <div class="lightbox-container">
      <button id="lightbox-close" class="lightbox-close-btn" aria-label="Close modal">✕</button>
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .writeup-header {
    margin-bottom: 32px;
  }
  .back-link {
    font-size: 13px;
    display: inline-block;
    margin-bottom: 12px;
  }
  h1 {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 4px;
  }
  .writeup-meta {
    color: var(--dim);
    font-size: 13px;
  }

  /* Full prose styling for rendered markdown */
  .writeup-content {
    line-height: 1.8;
  }
  .writeup-content :global(h2) {
    font-size: 16px;
    font-weight: 500;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
  }
  .writeup-content :global(h3) {
    font-size: 15px;
    font-weight: 500;
    margin-top: 24px;
    margin-bottom: 8px;
    color: var(--fg);
  }
  .writeup-content :global(h4) {
    font-size: 14px;
    font-weight: 500;
    margin-top: 20px;
    margin-bottom: 6px;
    color: #b0b0b0;
  }
  .writeup-content :global(p) {
    margin-bottom: 16px;
    color: #b0b0b0;
  }
  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
    color: #b0b0b0;
  }
  .writeup-content :global(li) {
    margin-bottom: 4px;
  }
  .writeup-content :global(li::marker) {
    color: var(--dim);
  }
  .writeup-content :global(code:not(pre code)) {
    background: #ffffff0d;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 0.9em;
    color: #c8c8c8;
  }
  .writeup-content :global(blockquote) {
    border-left: 2px solid var(--link);
    padding-left: 16px;
    margin: 16px 0;
    color: #999999;
    font-style: italic;
  }
  .writeup-content :global(figure.writeup-img-figure) {
    margin: 28px 0;
    background: #141414;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    text-align: center;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .writeup-content :global(figure.writeup-img-figure:hover) {
    border-color: #333333;
  }
  .writeup-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 4px;
    border: 1px solid var(--border);
    cursor: zoom-in;
    transition: all 0.2s ease;
  }
  .writeup-content :global(img:hover) {
    border-color: var(--link);
    box-shadow: 0 4px 16px rgba(126, 200, 160, 0.15);
  }
  .writeup-content :global(figcaption.writeup-img-caption) {
    margin-top: 10px;
    font-size: 12px;
    color: var(--dim);
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .writeup-content :global(.caption-icon) {
    opacity: 0.7;
  }
  .writeup-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 28px 0;
  }
  .writeup-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 13px;
  }
  .writeup-content :global(th),
  .writeup-content :global(td) {
    border: 1px solid var(--border);
    padding: 6px 10px;
    text-align: left;
    color: #b0b0b0;
  }
  .writeup-content :global(th) {
    color: var(--fg);
    font-weight: 500;
    background: #ffffff06;
  }
  .writeup-content :global(a) {
    color: var(--link);
  }
  .writeup-content :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox-modal.active {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(8px);
  }
  .lightbox-container {
    position: relative;
    z-index: 10000;
    max-width: 92vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: scale(0.95);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lightbox-modal.active .lightbox-container {
    transform: scale(1);
  }
  .lightbox-image {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
  }
  .lightbox-caption {
    margin-top: 12px;
    font-size: 12px;
    color: var(--fg);
    background: #161616;
    border: 1px solid var(--border);
    padding: 4px 14px;
    border-radius: 4px;
    font-family: inherit;
  }
  .lightbox-close-btn {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 32px;
    height: 32px;
    background: #222;
    border: 1px solid var(--border);
    color: var(--fg);
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    z-index: 10001;
  }
  .lightbox-close-btn:hover {
    background: var(--link);
    color: #111;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');

    const openLightbox = (src: string, alt: string) => {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightboxCaption.textContent = alt ? `📷 ${alt}` : '📷 Full Resolution Preview';
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
        closeLightbox();
      }
    });

    // Enhance images in writeup content (handles images pasted in between text gracefully)
    const contentImages = Array.from(document.querySelectorAll('.writeup-content img'));
    contentImages.forEach((img) => {
      const htmlImg = img as HTMLImageElement;
      htmlImg.loading = 'lazy';
      htmlImg.decoding = 'async';
      htmlImg.title = 'Click to expand image';

      const parent = htmlImg.parentElement;
      if (!parent || parent.tagName === 'FIGURE' || parent.tagName === 'A') {
        htmlImg.addEventListener('click', () => {
          openLightbox(htmlImg.src, htmlImg.alt || '');
        });
        return;
      }

      // Build figure wrapper
      const figure = document.createElement('figure');
      figure.className = 'writeup-img-figure';
      
      const clonedImg = htmlImg.cloneNode(true) as HTMLImageElement;
      figure.appendChild(clonedImg);

      if (htmlImg.alt && htmlImg.alt.trim() !== '') {
        const caption = document.createElement('figcaption');
        caption.className = 'writeup-img-caption';
        caption.innerHTML = `<span class="caption-icon">📷</span> ${htmlImg.alt}`;
        figure.appendChild(caption);
      }

      clonedImg.addEventListener('click', () => {
        openLightbox(clonedImg.src, clonedImg.alt || '');
      });

      if (parent.tagName === 'P') {
        const childNodes = Array.from(parent.childNodes);
        const imgIndex = childNodes.indexOf(htmlImg);

        const beforeNodes = childNodes.slice(0, imgIndex);
        const afterNodes = childNodes.slice(imgIndex + 1);

        const hasBeforeContent = beforeNodes.some(n => n.textContent && n.textContent.trim() !== '');
        const hasAfterContent = afterNodes.some(n => n.textContent && n.textContent.trim() !== '');

        const container = parent.parentElement;
        if (container) {
          if (!hasBeforeContent && !hasAfterContent) {
            // Paragraph contains only the image -> replace <p> with <figure>
            container.replaceChild(figure, parent);
          } else {
            // Image is pasted in between text -> split paragraph into before <p>, <figure>, and after <p>
            if (hasBeforeContent) {
              const pBefore = document.createElement('p');
              beforeNodes.forEach(node => pBefore.appendChild(node));
              container.insertBefore(pBefore, parent);
            }
            container.insertBefore(figure, parent);
            if (hasAfterContent) {
              const pAfter = document.createElement('p');
              afterNodes.forEach(node => pAfter.appendChild(node));
              container.insertBefore(pAfter, parent);
            }
            container.removeChild(parent);
          }
        }
      } else {
        parent.insertBefore(figure, htmlImg);
        parent.removeChild(htmlImg);
      }
    });
  });
</script>
