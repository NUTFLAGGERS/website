---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const writeups = await getCollection('writeups');
const projects = await getCollection('projects');

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

// Sort writeups & projects by date descending
writeups.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
projects.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const recentWriteups = writeups.slice(0, 3);
const featuredProjects = projects.slice(0, 2);
---

<BaseLayout title="NUTFLAGGERS — CTF Team" description="NUTFLAGGERS CTF Team — writeups, projects, and events.">
  <!-- Upcoming Events -->
  <section id="events">
    <div class="section-title-row">
      <div class="section-title">── upcoming events</div>
      <a href={`${base}events/`} class="section-more">all events →</a>
    </div>
    {events.map((event) => (
      <Row
        date={event.data.date}
        title={event.data.title}
        url={event.data.url || '#'}
        meta={`${event.data.location} · ${event.data.description}`}
        featured={event.data.featured}
        searchKeywords={`${event.data.title} ${event.data.location} ${event.data.description}`}
      />
    ))}
  </section>

  <!-- Recent Writeups -->
  <section id="writeups">
    <div class="section-title-row">
      <div class="section-title">── recent writeups</div>
      <a href={`${base}writeups/`} class="section-more">all writeups →</a>
    </div>
    {recentWriteups.map((w) => {
      const metaParts: string[] = [];
      if (w.data.type === 'individual' || w.data.event || w.data.author) {
        if (w.data.event) {
          metaParts.push(w.data.event);
        } else if (w.data.type === 'individual') {
          metaParts.push('indiv writeup');
        }
        if (w.data.author) metaParts.push(`by ${w.data.author}`);
        if (w.data.place) metaParts.push(w.data.place);
        if (w.data.score) metaParts.push(w.data.score);
      } else {
        if (w.data.place) metaParts.push(w.data.place);
        if (w.data.score) metaParts.push(w.data.score);
      }
      const metaText = metaParts.join(' · ');

      const searchTerms = [
        w.data.title,
        w.data.type || '',
        w.data.event || '',
        w.data.author || '',
        w.data.tags.join(' '),
        w.data.challenges.map((c) => c.name).join(' '),
      ].join(' ');

      return (
        <Row
          date={w.data.pubDate}
          title={w.data.title}
          url={`${base}writeups/${w.slug}/`}
          meta={metaText}
          tags={w.data.tags}
          challenges={w.data.challenges}
          searchKeywords={searchTerms}
        />
      );
    })}
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="section-title-row">
      <div class="section-title">── featured projects</div>
      <a href={`${base}projects/`} class="section-more">all projects →</a>
    </div>
    {featuredProjects.map((proj) => (
      <Row
        date={proj.data.date}
        title={proj.data.title}
        url={proj.data.githubUrl || proj.data.url || '#'}
        meta={`${proj.data.description} · ${proj.data.githubUrl ? 'github' : ''}`}
        tags={[proj.data.tag]}
        searchKeywords={`${proj.data.title} ${proj.data.description} ${proj.data.tag}`}
      />
    ))}
  </section>

  <!-- About Snapshot -->
  <section id="about">
    <div class="section-title-row">
      <div class="section-title">── about us</div>
      <a href={`${base}about/`} class="section-more">full roster & socials →</a>
    </div>
    <p class="about-text">
      We are NUTFLAGGERS — a student CTF team. We compete in international CTFs, write up challenge solutions, build open-source tools, and share security research.
    </p>
  </section>
</BaseLayout>

<style>
  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .section-title-row .section-title {
    margin-bottom: 0;
  }
  .section-more {
    font-size: 12px;
    color: var(--dim);
  }
  .section-more:hover {
    color: var(--link);
  }
</style>
