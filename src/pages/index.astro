---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const writeups = await getCollection('writeups');
const projects = await getCollection('projects');
const resources = await getCollection('resources');

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

const todayRef = '2026-08-01';

// 1. Upcoming events: future dates, sorted chronologically ascending (soonest first)
const upcomingEvents = events
  .filter((e) => {
    const d = e.data.startDate || e.data.date;
    return d && d >= todayRef;
  })
  .sort((a, b) => {
    const dateA = a.data.startDate ? new Date(a.data.startDate).getTime() : 0;
    const dateB = b.data.startDate ? new Date(b.data.startDate).getTime() : 0;
    return dateA - dateB;
  });

// 2. Featured events: featured tag === true, sorted descending
const featuredEvents = events
  .filter((e) => e.data.featured)
  .sort((a, b) => {
    const dateA = a.data.startDate ? new Date(a.data.startDate).getTime() : (a.data.date ? new Date(a.data.date).getTime() : 0);
    const dateB = b.data.startDate ? new Date(b.data.startDate).getTime() : (b.data.date ? new Date(b.data.date).getTime() : 0);
    return dateB - dateA;
  });

// Sort writeups by date descending
writeups.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Sort projects: featured first, then by date descending
projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const recentWriteups = writeups.slice(0, 3);
const featuredProjects = projects.slice(0, 2);
const featuredResources = resources.filter((r) => r.data.featured).slice(0, 3);
---

<BaseLayout title="NUTFLAGGERS — CTF Team" description="NUTFLAGGERS CTF Team — writeups, projects, and events.">
  <!-- Upcoming Events -->
  <section id="upcoming-events">
    <div class="section-title-row">
      <div class="section-title">── upcoming events</div>
      <a href={`${base}events/`} class="section-more">all events →</a>
    </div>
    {upcomingEvents.map((event) => {
      const metaParts: string[] = [];
      if (event.data.location) metaParts.push(event.data.location);
      if (event.data.description) metaParts.push(event.data.description);
      const metaText = metaParts.join(' · ');

      const searchTerms = [
        event.data.title,
        event.data.location || '',
        event.data.description || '',
        (event.data.tags || []).join(' '),
        (event.data.challenges || []).map((c) => c.name).join(' '),
      ].join(' ');

      return (
        <Row
          date={event.data.date}
          title={event.data.title}
          url={event.data.url || '#'}
          meta={metaText}
          featured={event.data.featured}
          tags={event.data.tags}
          challenges={event.data.challenges}
          searchKeywords={searchTerms}
        />
      );
    })}
  </section>

  <!-- Featured Events -->
  <section id="featured-events">
    <div class="section-title-row">
      <div class="section-title">── featured events</div>
      <a href={`${base}events/`} class="section-more">all events →</a>
    </div>
    {featuredEvents.map((event) => {
      const metaParts: string[] = [];
      if (event.data.location) metaParts.push(event.data.location);
      if (event.data.description) metaParts.push(event.data.description);
      const metaText = metaParts.join(' · ');

      const searchTerms = [
        event.data.title,
        event.data.location || '',
        event.data.description || '',
        (event.data.tags || []).join(' '),
        (event.data.challenges || []).map((c) => c.name).join(' '),
      ].join(' ');

      return (
        <Row
          date={event.data.date}
          title={event.data.title}
          url={event.data.url || '#'}
          meta={metaText}
          featured={event.data.featured}
          tags={event.data.tags}
          challenges={event.data.challenges}
          searchKeywords={searchTerms}
        />
      );
    })}
  </section>

  <!-- Recent Writeups -->
  <section id="writeups">
    <div class="section-title-row">
      <div class="section-title">── recent writeups</div>
      <a href={`${base}writeups/`} class="section-more">all writeups →</a>
    </div>
    {recentWriteups.map((w) => {
      const metaParts: string[] = [];
      if (w.data.event) metaParts.push(w.data.event);
      if (w.data.author) metaParts.push(`by ${w.data.author}`);
      if (w.data.score) metaParts.push(w.data.score);
      const metaText = metaParts.join(' · ');

      const searchTerms = [
        w.data.title,
        w.data.event || '',
        w.data.author || '',
        (w.data.tags || []).join(' '),
        w.data.description || '',
      ].join(' ');

      return (
        <Row
          date={w.data.pubDate}
          title={w.data.title}
          url={`${base}writeups/${w.slug}/`}
          meta={metaText}
          tags={w.data.tags}
          searchKeywords={searchTerms}
        />
      );
    })}
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="section-title-row">
      <div class="section-title">── featured projects</div>
      <a href={`${base}projects/`} class="section-more">all projects →</a>
    </div>
    {featuredProjects.map((proj) => (
      <Row
        date={proj.data.date}
        title={proj.data.title}
        url={proj.data.githubUrl || proj.data.url || '#'}
        meta={`${proj.data.description} · ${proj.data.githubUrl ? 'github' : ''}`}
        tags={[proj.data.tag]}
        searchKeywords={`${proj.data.title} ${proj.data.description} ${proj.data.tag}`}
      />
    ))}
  </section>

  <!-- Resources -->
  <section id="resources">
    <div class="section-title-row">
      <div class="section-title">── ctf resources & tools</div>
      <a href={`${base}resources/`} class="section-more">all resources →</a>
    </div>
    {featuredResources.map((res) => (
      <Row
        date={res.data.category}
        title={res.data.title}
        url={res.data.url}
        meta={res.data.description}
        tags={res.data.tags}
        searchKeywords={`${res.data.title} ${res.data.category} ${res.data.description} ${res.data.tags.join(' ')}`}
      />
    ))}
  </section>

  <!-- About Snapshot -->
  <section id="about">
    <div class="section-title-row">
      <div class="section-title">── about us</div>
      <a href={`${base}about/`} class="section-more">full roster & socials →</a>
    </div>
    <p class="about-text">
      We are NUTFLAGGERS — a student CTF team. We compete in international CTFs, write up challenge solutions, build open-source tools, and share security research.
    </p>
  </section>
</BaseLayout>

<style>
  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .section-title-row .section-title {
    margin-bottom: 0;
  }
  .section-more {
    font-size: 12px;
    color: var(--dim);
  }
  .section-more:hover {
    color: var(--link);
  }
</style>
