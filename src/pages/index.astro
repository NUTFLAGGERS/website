---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const writeups = await getCollection('writeups');
const projects = await getCollection('projects');
const teamMembers = await getCollection('team');

// Sort writeups & projects by date descending
writeups.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
projects.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="NUTFLAGGERS — CTF Team" description="NUTFLAGGERS CTF Team — writeups, projects, and events.">
  <!-- Upcoming Events -->
  <section id="events">
    <div class="section-title">── upcoming events</div>
    {events.map((event) => (
      <Row
        date={event.data.date}
        title={event.data.title}
        url={event.data.url || '#'}
        meta={`${event.data.location} · ${event.data.description}`}
        featured={event.data.featured}
        searchKeywords={`${event.data.title} ${event.data.location} ${event.data.description}`}
      />
    ))}
  </section>

  <!-- CTF Writeups -->
  <section id="writeups">
    <div class="section-title">── ctf writeups</div>
    {writeups.map((w) => {
      const metaParts = [];
      if (w.data.place) metaParts.push(w.data.place);
      if (w.data.score) metaParts.push(w.data.score);
      const metaText = metaParts.join(' · ');

      return (
        <Row
          date={w.data.pubDate}
          title={w.data.title}
          url={import.meta.env.BASE_URL + `writeups/${w.slug}/`}
          meta={metaText}
          tags={w.data.tags}
          challenges={w.data.challenges}
          searchKeywords={`${w.data.title} ${w.data.tags.join(' ')} ${w.data.challenges.map(c => c.name).join(' ')}`}
        />
      );
    })}
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="section-title">── projects</div>
    {projects.map((proj) => (
      <Row
        date={proj.data.date}
        title={proj.data.title}
        url={proj.data.githubUrl || proj.data.url || '#'}
        meta={`${proj.data.description} · ${proj.data.githubUrl ? 'github' : ''}`}
        tags={[proj.data.tag]}
        searchKeywords={`${proj.data.title} ${proj.data.description} ${proj.data.tag}`}
      />
    ))}
  </section>

  <!-- About -->
  <section id="about">
    <div class="section-title">── about us</div>
    <p style="color: #999999; max-width: 560px; margin-bottom: 20px;">
      We are NUTFLAGGERS — a student CTF team. We compete, write things up, build tools, and try to learn something every time. If you're interested in security, come find us.
    </p>

    <div class="section-title" style="margin-top: 24px;">── the team <span style="font-size: 11px;">(optional)</span></div>
    <div class="team-list">
      {teamMembers.map((member) => (
        <div class="team-row">
          <span class="handle">{member.data.handle}</span> · {member.data.role}
        </div>
      ))}
    </div>

    <div class="section-title" style="margin-top: 28px;">── find us</div>
    <div class="socials">
      <a href="https://discord.gg" target="_blank" rel="noopener noreferrer">discord</a>
      <a href="https://github.com/NUTFLAGGERS" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://ctftime.org" target="_blank" rel="noopener noreferrer">ctftime</a>
      <a href="https://twitter.com" target="_blank" rel="noopener noreferrer">twitter</a>
      <a href="mailto:contact@nutflaggers.org">email</a>
    </div>
  </section>
</BaseLayout>
