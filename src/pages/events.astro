---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
events.sort((a, b) => {
  const dateA = a.data.startDate ? new Date(a.data.startDate).getTime() : (a.data.date ? new Date(a.data.date).getTime() : 0);
  const dateB = b.data.startDate ? new Date(b.data.startDate).getTime() : (b.data.date ? new Date(b.data.date).getTime() : 0);
  return dateB - dateA;
});
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<BaseLayout title="Events — NUTFLAGGERS" description="Upcoming and past CTF competitions and events for NUTFLAGGERS.">
  <section id="events">
    <div class="section-title">── events</div>
    {events.length > 0 ? (
      events.map((event) => {
        const metaParts: string[] = [];
        if (event.data.location) metaParts.push(event.data.location);
        if (event.data.description) metaParts.push(event.data.description);
        const metaText = metaParts.join(' · ');

        const searchTerms = [
          event.data.title,
          event.data.location || '',
          event.data.description || '',
          (event.data.tags || []).join(' '),
          (event.data.challenges || []).map((c) => c.name).join(' '),
        ].join(' ');

        const eventUrl = `${base}events/${event.slug}/`;

        return (
          <Row
            date={event.data.date}
            title={event.data.title}
            url={eventUrl}
            meta={metaText}
            featured={event.data.featured}
            tags={event.data.tags}
            challenges={event.data.challenges}
            searchKeywords={searchTerms}
          />
        );
      })
    ) : (
      <p class="empty-msg">More content coming soon!</p>
    )}
  </section>
</BaseLayout>
